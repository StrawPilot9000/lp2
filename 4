import heapq

# 1. Define the Goal State as a 1D tuple (0 is the empty space)
GOAL = (1, 2, 3, 4, 5, 6, 7, 8, 0)

# 2. The Heuristic: Manhattan Distance
def manhattan(state):
    distance = 0
    for i in range(9):
        if state[i] != 0:
            # Get current (x, y) coordinates
            curr_x, curr_y = i % 3, i // 3
            
            # Get goal (x, y) coordinates
            goal_index = GOAL.index(state[i])
            goal_x, goal_y = goal_index % 3, goal_index // 3
            
            # Add the absolute difference in rows and columns
            distance += abs(curr_x - goal_x) + abs(curr_y - goal_y)
    return distance

# 3. The A* Search Algorithm
def a_star_8_puzzle(start_state):
    # Priority Queue: (f_score, g_score, state, path_taken)
    g = 0
    h = manhattan(start_state)
    pq = [(g + h, g, start_state, [])]
    
    visited = set()
    
    # Pre-defined valid moves for the empty space (0)
    # If 0 is at index 'i', it can swap with the indexes in the list
    moves = {
        0: [1, 3],    1: [0, 2, 4],    2: [1, 5],
        3: [0, 4, 6], 4: [1, 3, 5, 7], 5: [2, 4, 8],
        6: [3, 7],    7: [4, 6, 8],    8: [5, 7]
    }
    
    while pq:
        f, current_g, state, path = heapq.heappop(pq)
        
        # Base/Goal Condition
        if state == GOAL:
            print(f"Goal reached in {current_g} moves!\n")
            for step in path + [state]:
                print(f"{step[0]} {step[1]} {step[2]}\n{step[3]} {step[4]} {step[5]}\n{step[6]} {step[7]} {step[8]}\n")
            return
            
        if state in visited:
            continue
            
        visited.add(state)
        
        # 4. Generate Neighbors
        zero_index = state.index(0) # Find where the empty space is
        
        for move in moves[zero_index]:
            # Convert tuple to list to swap items, then back to tuple
            new_state = list(state)
            new_state[zero_index], new_state[move] = new_state[move], new_state[zero_index]
            new_state = tuple(new_state)
            
            if new_state not in visited:
                new_g = current_g + 1
                new_h = manhattan(new_state)
                # Push new state, increasing g by 1, and appending current state to path
                heapq.heappush(pq, (new_g + new_h, new_g, new_state, path + [state]))

# Run the code with an easy solvable starting state
start = (1, 2, 3, 4, 0, 5, 7, 8, 6) 
print("8-Puzzle A* Solution Steps:")
a_star_8_puzzle(start)
