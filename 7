# AI 7 (Part A): Prim's Minimum Spanning Tree

graph = [
    [0, 2, 0, 6, 0],
    [2, 0, 3, 8, 5],
    [0, 3, 0, 0, 7],
    [6, 8, 0, 0, 9],
    [0, 5, 7, 9, 0]
]

def prims_mst(graph):
    V = len(graph)
    selected = [False] * V
    selected[0] = True
    edges_count = 0
    
    print("Edge \tWeight")
    while edges_count < V - 1:
        minimum = float('inf')
        x = y = 0
        
        for i in range(V):
            if selected[i]:
                for j in range(V):
                    if not selected[j] and graph[i][j] != 0:  
                        if graph[i][j] < minimum:
                            minimum = graph[i][j]
                            x, y = i, j
                            
        print(f"{x} - {y} \t  {graph[x][y]}")
        selected[y] = True
        edges_count += 1

prims_mst(graph)



# AI 7 (Part B): Kruskal's Minimum Spanning Tree

def kruskals_mst(V, edges):
    # 1. Sort all edges based on weight (index 2)
    edges.sort(key=lambda x: x[2])
    
    # Track the "parent" of each node to detect cycles
    # Initially, every node is its own parent: [0, 1, 2, 3, ...]
    parent = list(range(V))
    
    # 2. Helper function to find the root parent of a node
    def find_root(i):
        if parent[i] == i:
            return i
        return find_root(parent[i])
        
    print("Edge \tWeight")
    
    # 3. Greedily pick the cheapest edges
    for u, v, weight in edges:
        root_u = find_root(u)
        root_v = find_root(v)
        
        # If they have different roots, adding this edge WON'T create a loop
        if root_u != root_v:
            print(f"{u} - {v} \t  {weight}")
            # Connect them by making one root the parent of the other (Union)
            parent[root_u] = root_v

# Format: (Node1, Node2, Weight)
# Example graph with 4 vertices (0 to 3)
graph_edges = [
    (0, 1, 10), 
    (0, 2, 6), 
    (0, 3, 5), 
    (1, 3, 15), 
    (2, 3, 4)
]

kruskals_mst(4, graph_edges)
